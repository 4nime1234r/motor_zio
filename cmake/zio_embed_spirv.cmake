if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "zio_embed_spirv.cmake requires -DINPUT=, -DOUTPUT=, -DSYMBOL=")
endif()

file(READ "${INPUT}" hexContent HEX)
string(LENGTH "${hexContent}" hexLength)
math(EXPR wordCount "${hexLength} / 8")

set(words "")
foreach(i RANGE 1 ${wordCount})
    math(EXPR wordStart "(${i} - 1) * 8")
    string(SUBSTRING "${hexContent}" ${wordStart} 8 wordHexLE)

    string(SUBSTRING "${wordHexLE}" 0 2 b0)
    string(SUBSTRING "${wordHexLE}" 2 2 b1)
    string(SUBSTRING "${wordHexLE}" 4 2 b2)
    string(SUBSTRING "${wordHexLE}" 6 2 b3)
    list(APPEND words "0x${b3}${b2}${b1}${b0}")
endforeach()

list(JOIN words ",\n    " wordsJoined)

file(WRITE "${OUTPUT}"
"// Generated by zio_embed_spirv.cmake from ${INPUT} - do not edit by hand.
#pragma once
#include <cstdint>
inline constexpr std::uint32_t ${SYMBOL}[] = {
    ${wordsJoined}
};
")
