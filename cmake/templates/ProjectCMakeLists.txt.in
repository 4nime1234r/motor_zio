cmake_minimum_required(VERSION 3.20)
project(__PROJECT_NAME__ LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()

find_package(zio CONFIG REQUIRED PATHS "${CMAKE_CURRENT_SOURCE_DIR}/../../sdk" NO_DEFAULT_PATH)
include("${CMAKE_CURRENT_SOURCE_DIR}/../../sdk/lib/cmake/zio/zio_optimizations.cmake")
include("${CMAKE_CURRENT_SOURCE_DIR}/../../sdk/lib/cmake/zio/zio_gui.cmake")

add_executable(__PROJECT_NAME__ main.cpp)
zio_set_gui_app(__PROJECT_NAME__)
target_link_libraries(__PROJECT_NAME__ PRIVATE zio::engine)
zio_enable_optimizations(__PROJECT_NAME__)
